# Beside works with no keys at all (sample visit, offline decoder, English).
# Add a key to turn on AI: smarter decoding, reply prediction, addressee
# detection, translation into 15 languages, AI recaps, and Whisper captions.
# Local: copy this file to .env. Vercel: Project Settings > Environment Variables.
# The first provider with a key wins (Groq, then Hugging Face, then Claude).

# --- Groq (recommended: fastest, and also powers Whisper captions) ---
# Key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Default: openai/gpt-oss-120b
GROQ_MODEL=
# Optional: a different model per task (TURN, SIMPLIFY, TRANSLATE, STRINGS, RECAP).
GROQ_MODEL_TURN=
# Optional. Default: whisper-large-v3-turbo
GROQ_STT_MODEL=

# --- Video and live sync across different networks (optional) ---
# Same Wi-Fi works without this. Different networks (mobile data vs. home Wi-Fi)
# need a TURN relay. Cloudflare's is free up to 1,000 GB a month:
# dash.cloudflare.com > Realtime > TURN Server > Create, then copy both values.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
# Or any other TURN provider (comma-separated URLs):
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Hugging Face Inference Providers ---
HF_TOKEN=
HF_MODEL=

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=

# Optional: force a provider when several keys are set (groq | huggingface | anthropic).
AI_PROVIDER=
